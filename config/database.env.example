# ==============================================================================
# DatabaseCreator - Environment Configuration Template
# ==============================================================================
#
# USAGE INSTRUCTIONS:
# 1. Copy this template to create your local private configuration:
#      cp config/database.env.example config/database.env
#    OR:
#      cp config/database.env.example Database.properties.local
# 2. Update the credentials below with strong, unique passwords.
# 3. 'config/database.env' and '*.local.properties' are strictly gitignored to
#    prevent credential leakage into version control.
#
# PRECEDENCE ORDER:
#   1. Explicit CLI arguments (e.g. -p 3307, -n custom-db)
#   2. Local override file (Database.properties.local / config/database.env)
#   3. Central properties file (Database.properties)
#   4. Built-in script defaults
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Global Orchestrator Settings
# ------------------------------------------------------------------------------
# Container runtime engine to utilize ('podman' or 'docker').
# Leave empty for automatic prioritized detection (Podman first, Docker fallback).
CONTAINER_ENGINE=podman

# Default container instance name when not specified via -n/--database-name
DEFAULT_DATABASE_NAME=localdb

# Default container image repository prefix for locally built images
DEFAULT_IMAGE_REPO=local.image

# Default host directory base path when persistent storage (-d) is enabled
DATA_PERSISTENCE_ROOT=/var/data/databases

# ------------------------------------------------------------------------------
# 2. Relational Database: MySQL
# ------------------------------------------------------------------------------
# Driver Class: com.mysql.cj.jdbc.Driver
# JDBC URL Template: jdbc:mysql://localhost:3306/userdata?allowPublicKeyRetrieval=true&useSSL=false
MYSQL_PORT=3306
MYSQL_DBNAME=userdata
MYSQL_USER_ID=userid
MYSQL_USER_PASSWORD=ChangeMeStrongPassword!
MYSQL_ROOT_PASSWORD=RootChangeMeStrongPassword!

# ------------------------------------------------------------------------------
# 3. Relational Database: MariaDB
# ------------------------------------------------------------------------------
# Driver Class: org.mariadb.jdbc.Driver
# JDBC URL Template: jdbc:mariadb://localhost:3306/userdata
MARIADB_PORT=3306
MARIADB_DBNAME=userdata
MARIADB_USER_ID=userid
MARIADB_USER_PASSWORD=ChangeMeStrongPassword!
MARIADB_ROOT_PASSWORD=RootChangeMeStrongPassword!

# ------------------------------------------------------------------------------
# 4. Relational Database: PostgreSQL
# ------------------------------------------------------------------------------
# Driver Class: org.postgresql.Driver
# JDBC URL Template: jdbc:postgresql://localhost:5432/pgdb
POSTGRES_PORT=5432
POSTGRES_DBNAME=pgdb
POSTGRES_USER_ID=userid
POSTGRES_USER_PASSWORD=ChangeMeStrongPassword!
POSTGRES_USER_SCHEMA=userdata

# ------------------------------------------------------------------------------
# 5. Relational Database: Microsoft SQL Server (MSSQL)
# ------------------------------------------------------------------------------
# Driver Class: com.microsoft.sqlserver.jdbc.SQLServerDriver
# JDBC URL Template: jdbc:sqlserver://localhost:1433;databaseName=mssql;trustServerCertificate=true;
# Note: SA Password must meet Microsoft complexity requirements (upper, lower, digit, symbol)
MSSQL_PORT=1433
MSSQL_SA=sa
MSSQL_SA_PASSWORD=ChangeMeStrongPassword123!
MSSQL_DBNAME=mssql
MSSQL_USER_ID=userid
MSSQL_USER_PASSWORD=ChangeMeStrongPassword123!
MSSQL_USER_SCHEMA=userdata

# ------------------------------------------------------------------------------
# 6. Relational Database: Oracle Autonomous Database Free / XE
# ------------------------------------------------------------------------------
# Driver Class: oracle.jdbc.OracleDriver
# JDBC URL Template: jdbc:oracle:thin:@//localhost:1521/oracledb
# Note: Passwords must NOT contain '@' due to sqlplus connection string parsing
ORACLE_PORT=1521
ORACLE_ADMIN_PASSWORD=OracleChangeMe123!
ORACLE_WALLET_PASSWORD=OracleChangeMe123!
ORACLE_DBNAME=oracledb
ORACLE_USER_ID=userid
ORACLE_USER_PASSWORD=OracleChangeMe123!

# ------------------------------------------------------------------------------
# 7. Relational Database: IBM DB2 Community Edition
# ------------------------------------------------------------------------------
# Driver Class: com.ibm.db2.jcc.DB2Driver
# JDBC URL Template: jdbc:db2://localhost:50000/ibmdb:progressiveLocators=2;
DB2_PORT=50000
DB2_DB2INSTANCE=db2inst
DB2_DB2INST1_PASSWORD=ChangeMeStrongPassword!
DB2_DBNAME=ibmdb
DB2_USER_ID=userid
DB2_USER_PASS=ChangeMeStrongPassword!
DB2_USER_SCHEMA=userdata

# ------------------------------------------------------------------------------
# 8. Document NoSQL: MongoDB
# ------------------------------------------------------------------------------
# Driver Class: mongodb.jdbc.MongoDriver (or native mongo client)
# Connection URI Template: mongodb://userid:password@localhost:27017/mgdb?authSource=admin
MONGODB_PORT=27017
MONGODB_DBNAME=mgdb
MONGODB_USER_ID=userid
MONGODB_USER_PASSWORD=ChangeMeStrongPassword!
MONGODB_USER_SCHEMA=userdata

# ------------------------------------------------------------------------------
# 9. In-Memory Cache & Key-Value: Redis / Valkey
# ------------------------------------------------------------------------------
# Connection URI Template: redis://:password@localhost:6379/0
REDIS_PORT=6379
REDIS_PASSWORD=ChangeMeStrongPassword!

# ------------------------------------------------------------------------------
# 10. Columnar Analytics / OLAP: ClickHouse
# ------------------------------------------------------------------------------
# Driver Class: com.clickhouse.jdbc.ClickHouseDriver
# HTTP URL: http://localhost:8123/
# Native JDBC URL Template: jdbc:ch://localhost:8123/userdata
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DBNAME=userdata
CLICKHOUSE_USER_ID=userid
CLICKHOUSE_USER_PASSWORD=ChangeMeStrongPassword!

# ------------------------------------------------------------------------------
# 11. Distributed Cloud SQL: CockroachDB
# ------------------------------------------------------------------------------
# Driver Class: org.postgresql.Driver
# SQL Port: 26257 (Postgres wire protocol) | Web Admin Console: 8080
# JDBC URL Template: jdbc:postgresql://localhost:26257/userdata?sslmode=disable
COCKROACH_PORT=26257
COCKROACH_WEB_PORT=8080
COCKROACH_DBNAME=userdata
COCKROACH_USER_ID=userid
COCKROACH_USER_PASSWORD=ChangeMeStrongPassword!

# ------------------------------------------------------------------------------
# 12. Cloud Warehouse Local Emulator: Snowflake
# ------------------------------------------------------------------------------
# Driver Class: net.snowflake.client.jdbc.SnowflakeDriver
# REST & Query Protocol Port: 8080
# JDBC URL Template: jdbc:snowflake://localhost:8080/?db=USERDATA&schema=PUBLIC&warehouse=COMPUTE_WH&ssl=off
SNOWFLAKE_PORT=8080
SNOWFLAKE_DBNAME=USERDATA
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_USER_ID=userid
SNOWFLAKE_USER_PASSWORD=ChangeMeStrongPassword!

# ------------------------------------------------------------------------------
# 13. Cloud Lakehouse Local Engine: Databricks (Apache Spark + Delta Lake)
# ------------------------------------------------------------------------------
# Driver Class: org.apache.hive.jdbc.HiveDriver
# Spark Hive Thrift JDBC Port: 10000 | Spark Web UI: 4040
# JDBC URL Template: jdbc:hive2://localhost:10000/userdata;auth=noSasl
DATABRICKS_PORT=10000
DATABRICKS_WEB_PORT=4040
DATABRICKS_DBNAME=userdata
DATABRICKS_USER_ID=userid
DATABRICKS_USER_PASSWORD=ChangeMeStrongPassword!
