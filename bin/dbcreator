#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Copyright (c) 2024-2026 Vivek Umrao and DatabaseCreator contributors.
# ==============================================================================
# bin/dbcreator - Unified Multi-Vendor Database & Cache CLI
# ==============================================================================

set -eo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Source modular libraries
source "${PROJECT_ROOT}/lib/logger.sh"
source "${PROJECT_ROOT}/lib/config.sh"
source "${PROJECT_ROOT}/lib/engine.sh"
source "${PROJECT_ROOT}/lib/health.sh"
source "${PROJECT_ROOT}/lib/lifecycle.sh"

PROPERTIES_FILE="${PROJECT_ROOT}/Database.properties"

# Default configuration
CONTAINER_DB_TYPE="mysql"
CONTAINER_DB_VERSION="latest"
CONTAINER_DB_NAME="localdb"
CONTAINER_DB_PORT=""
CONTAINER_IMAGE_NAME="img"
CONTAINER_REPO_NAME="local.image"
CONTAINER_ENGINE=""
DATA_VOLUME=""
PREFLIGHT_ONLY=false

show_usage() {
  echo -e "$(cat << EOF

${CLR_BOLD}Database Creator - Multi-Vendor Database & Cache Container Orchestrator${CLR_RESET}

${CLR_BOLD}USAGE:${CLR_RESET}
  dbcreator [OPTIONS]
  ./CreateDB.sh [OPTIONS]

${CLR_BOLD}DATABASE & CACHE ENGINES (-t, --database-type):${CLR_RESET}
  * mysql         - MySQL Relational Database (Default port: 3306)
  * mariadb       - MariaDB Relational Database (Default port: 3306)
  * postgres      - PostgreSQL Object-Relational Database (Default port: 5432)
  * mssql         - Microsoft SQL Server (Default port: 1433)
  * oracle        - Oracle Autonomous Database Free (Default port: 1521)
  * mongodb       - MongoDB Document NoSQL Database (Default port: 27017)
  * db2           - IBM DB2 Enterprise Database (Default port: 50000)
  * redis         - Redis / Valkey In-Memory Key-Value & Cache (Default port: 6379)
  * clickhouse    - ClickHouse Columnar OLAP Analytics Database (Default port: 8123)
  * cockroach     - CockroachDB Distributed SQL Database (Default port: 26257, Web UI: 8080)
  * snowflake     - Snowflake Local Emulator with DuckDB Engine (Default port: 8080)
  * databricks    - Databricks Local Engine: Apache Spark + Delta Lake (Default port: 10000, UI: 4040)

${CLR_BOLD}OPTIONS:${CLR_RESET}
  -t, --database-type <vendor>     Database engine vendor (Default: mysql)
  -v, --database-version <ver>     Base image version tag (Default: latest)
  -n, --database-name <name>       Container name (Default: localdb)
  -p, --docker-port, --port <port> Host port mapping to database service
  -i, --image-name <name>          Local container image tag name (Default: img)
  -r, --image-repo <repo>          Image repository namespace (Default: local.image)
  -e, --engine <engine>            Force engine: 'podman' or 'docker' (Default: auto-detect)
  -d, --data-dir, --volume <vol>   Host directory or named volume for data persistence
  -c, --check, --preflight         Run host environment & library pre-flight checkup only
  -h, --help                       Show this help message

${CLR_BOLD}CONTAINER LIFECYCLE SHORTCUTS:${CLR_RESET}
  dbcreator status [name]          View running database containers
  dbcreator stop [name]            Stop a running database container
  dbcreator logs [name]            Tail database container logs
  dbcreator rm [name]              Stop and remove database container

${CLR_BOLD}EXAMPLES:${CLR_RESET}
  # Run host environment & tool pre-flight checkup:
  dbcreator --preflight

  # Spin up MySQL on port 3306:
  dbcreator -t mysql -p 3306 -n dev-mysql

  # Spin up Redis Cache on port 6379:
  dbcreator -t redis -p 6379 -n dev-redis

  # Spin up MariaDB with persistent data volume:
  dbcreator -t mariadb -p 3306 -n dev-mariadb -d /data/mariadb

  # Spin up ClickHouse Columnar Analytics on port 8123:
  dbcreator -t clickhouse -p 8123 -n dev-clickhouse

  # Spin up PostgreSQL 16 on port 5432:
  dbcreator -t postgres -v 16 -p 5432 -n dev-pg

  # Spin up CockroachDB with Web Console:
  dbcreator -t cockroach -p 26257 -n dev-cockroach

  # Spin up Snowflake Local Emulator:
  dbcreator -t snowflake -p 8080 -n dev-snowflake

  # Spin up Databricks Local Lakehouse Engine:
  dbcreator -t databricks -p 10000 -n dev-databricks
EOF
)"
}

# Check for lifecycle subcommands first
if [[ "$#" -gt 0 ]]; then
  case "${1,,}" in
    status|stop|logs|rm|remove)
      handle_lifecycle_command "${1,,}" "$2"
      ;;
  esac
fi

# Parse options
while [[ $# -gt 0 ]]; do
  case "${1,,}" in
    -t|--database-type)
      CONTAINER_DB_TYPE="$2"
      shift 2
      ;;
    -v|--database-version)
      CONTAINER_DB_VERSION="$2"
      shift 2
      ;;
    -n|--database-name)
      CONTAINER_DB_NAME="$2"
      shift 2
      ;;
    -p|--docker-port|--port)
      CONTAINER_DB_PORT="$2"
      shift 2
      ;;
    -i|--image-name)
      CONTAINER_IMAGE_NAME="$2"
      shift 2
      ;;
    -r|--image-repo)
      CONTAINER_REPO_NAME="$2"
      shift 2
      ;;
    -e|--engine)
      CONTAINER_ENGINE="$2"
      shift 2
      ;;
    -d|--data-dir|--volume)
      DATA_VOLUME="$2"
      shift 2
      ;;
    -c|--check|--preflight)
      PREFLIGHT_ONLY=true
      shift 1
      ;;
    -h|--help)
      show_usage
      exit 0
      ;;
    *)
      log_error "Unknown option: $1"
      show_usage
      exit 1
      ;;
  esac
done

# Run host environment & library pre-flight checkup
run_preflight_check

log_info "Using Container Engine: ${CLR_BOLD}${CONTAINER_ENGINE}${CLR_RESET}"

# Safe temporary build workspace with automated cleanup trap
BUILD_DIR="$(mktemp -d "${PROJECT_ROOT}/build.XXXXXX")"
cleanup() {
  if [[ -d "${BUILD_DIR}" ]]; then
    rm -rf "${BUILD_DIR}"
  fi
}
trap cleanup EXIT INT TERM

FULL_IMAGE_TAG="${CONTAINER_REPO_NAME}:${CONTAINER_IMAGE_NAME}"

BUILD_OPTS=()
if [[ "${CONTAINER_ENGINE}" == "podman" ]]; then
  BUILD_OPTS=("--format" "docker")
fi

# Format volume argument if requested
VOLUME_ARG=()
get_volume_param() {
  local container_dest="$1"
  if [[ -n "${DATA_VOLUME}" ]]; then
    if [[ -d "${DATA_VOLUME}" || "${DATA_VOLUME}" =~ ^/ ]]; then
      mkdir -p "${DATA_VOLUME}" 2>/dev/null || true
      VOLUME_ARG=("-v" "${DATA_VOLUME}:${container_dest}:Z")
    else
      VOLUME_ARG=("-v" "${DATA_VOLUME}:${container_dest}")
    fi
    log_info "Persistent Volume configured: ${DATA_VOLUME} -> ${container_dest}"
  fi
}

# ------------------------------------------------------------------------------
# Dispatch to Target Engine
# ------------------------------------------------------------------------------
case "${CONTAINER_DB_TYPE,,}" in

  mysql)
    DEFAULT_PORT=3306
    CONTAINER_DB_PORT="${CONTAINER_DB_PORT:-$DEFAULT_PORT}"
    get_volume_param "/var/lib/mysql"
    log_info "Building & launching MySQL..."
    cp -rf "${PROJECT_ROOT}/Database/MYSQL/." "${BUILD_DIR}/"

    dockerfile="${BUILD_DIR}/Dockerfile"
    sed -i "s/MYSQL_DATABASE_VALUE/$(get_property 'MYSQL_DBNAME')/g" "${dockerfile}"
    sed -i "s/MYSQL_USER_VALUE/$(get_property 'MYSQL_USER_ID')/g" "${dockerfile}"
    sed -i "s/MYSQL_PASSWORD_VALUE/$(get_property 'MYSQL_USER_PASSWORD')/g" "${dockerfile}"
    sed -i "s/MYSQL_ROOT_PASSWORD_VALUE/$(get_property 'MYSQL_ROOT_PASSWORD')/g" "${dockerfile}"

    (cd "${BUILD_DIR}" && "${CONTAINER_ENGINE}" build "${BUILD_OPTS[@]}" . -t "${FULL_IMAGE_TAG}" --build-arg DB_VERSION="${CONTAINER_DB_VERSION}")
    "${CONTAINER_ENGINE}" run -d --name "${CONTAINER_DB_NAME}" -p "${CONTAINER_DB_PORT}:${DEFAULT_PORT}" "${VOLUME_ARG[@]}" "${FULL_IMAGE_TAG}"
    ;;

  mariadb)
    DEFAULT_PORT=3306
    CONTAINER_DB_PORT="${CONTAINER_DB_PORT:-$DEFAULT_PORT}"
    get_volume_param "/var/lib/mysql"
    log_info "Building & launching MariaDB..."
    cp -rf "${PROJECT_ROOT}/Database/MariaDB/." "${BUILD_DIR}/"

    dockerfile="${BUILD_DIR}/Dockerfile"
    sed -i "s/MARIADB_DATABASE_VALUE/$(get_property 'MARIADB_DBNAME')/g" "${dockerfile}"
    sed -i "s/MARIADB_USER_VALUE/$(get_property 'MARIADB_USER_ID')/g" "${dockerfile}"
    sed -i "s/MARIADB_PASSWORD_VALUE/$(get_property 'MARIADB_USER_PASSWORD')/g" "${dockerfile}"
    sed -i "s/MARIADB_ROOT_PASSWORD_VALUE/$(get_property 'MARIADB_ROOT_PASSWORD')/g" "${dockerfile}"

    (cd "${BUILD_DIR}" && "${CONTAINER_ENGINE}" build "${BUILD_OPTS[@]}" . -t "${FULL_IMAGE_TAG}" --build-arg DB_VERSION="${CONTAINER_DB_VERSION}")
    "${CONTAINER_ENGINE}" run -d --name "${CONTAINER_DB_NAME}" -p "${CONTAINER_DB_PORT}:${DEFAULT_PORT}" "${VOLUME_ARG[@]}" "${FULL_IMAGE_TAG}"
    ;;

  redis|valkey)
    DEFAULT_PORT=6379
    CONTAINER_DB_PORT="${CONTAINER_DB_PORT:-$DEFAULT_PORT}"
    get_volume_param "/data"
    log_info "Building & launching Redis / Valkey Cache..."
    cp -rf "${PROJECT_ROOT}/Database/Redis/." "${BUILD_DIR}/"

    dockerfile="${BUILD_DIR}/Dockerfile"
    sed -i "s/REDIS_PASSWORD_VALUE/$(get_property 'REDIS_PASSWORD')/g" "${dockerfile}"

    (cd "${BUILD_DIR}" && "${CONTAINER_ENGINE}" build "${BUILD_OPTS[@]}" . -t "${FULL_IMAGE_TAG}" --build-arg DB_VERSION="${CONTAINER_DB_VERSION}")
    "${CONTAINER_ENGINE}" run -d --name "${CONTAINER_DB_NAME}" -p "${CONTAINER_DB_PORT}:${DEFAULT_PORT}" "${VOLUME_ARG[@]}" "${FULL_IMAGE_TAG}"
    ;;

  clickhouse)
    DEFAULT_PORT=8123
    CONTAINER_DB_PORT="${CONTAINER_DB_PORT:-$DEFAULT_PORT}"
    get_volume_param "/var/lib/clickhouse"
    log_info "Building & launching ClickHouse Analytics..."
    cp -rf "${PROJECT_ROOT}/Database/ClickHouse/." "${BUILD_DIR}/"

    dockerfile="${BUILD_DIR}/Dockerfile"
    sed -i "s/CLICKHOUSE_DB_VALUE/$(get_property 'CLICKHOUSE_DBNAME')/g" "${dockerfile}"
    sed -i "s/CLICKHOUSE_USER_VALUE/$(get_property 'CLICKHOUSE_USER_ID')/g" "${dockerfile}"
    sed -i "s/CLICKHOUSE_PASSWORD_VALUE/$(get_property 'CLICKHOUSE_USER_PASSWORD')/g" "${dockerfile}"

    (cd "${BUILD_DIR}" && "${CONTAINER_ENGINE}" build "${BUILD_OPTS[@]}" . -t "${FULL_IMAGE_TAG}" --build-arg DB_VERSION="${CONTAINER_DB_VERSION}")
    "${CONTAINER_ENGINE}" run -d --name "${CONTAINER_DB_NAME}" -p "${CONTAINER_DB_PORT}:${DEFAULT_PORT}" -p 9000:9000 "${VOLUME_ARG[@]}" "${FULL_IMAGE_TAG}"
    ;;

  postgres|postgresql)
    DEFAULT_PORT=5432
    CONTAINER_DB_PORT="${CONTAINER_DB_PORT:-$DEFAULT_PORT}"
    get_volume_param "/var/lib/postgresql/data"
    log_info "Building & launching PostgreSQL..."
    cp -rf "${PROJECT_ROOT}/Database/PostgreSQL/." "${BUILD_DIR}/"

    dockerfile="${BUILD_DIR}/Dockerfile"
    sed -i "s/POSTGRES_DB_VALUE/$(get_property 'POSTGRES_DBNAME')/g" "${dockerfile}"
    sed -i "s/POSTGRES_USER_VALUE/$(get_property 'POSTGRES_USER_ID')/g" "${dockerfile}"
    sed -i "s/POSTGRES_PASSWORD_VALUE/$(get_property 'POSTGRES_USER_PASSWORD')/g" "${dockerfile}"
    sed -i "s/POSTGRES_SCHEMA_VALUE/$(get_property 'POSTGRES_USER_SCHEMA')/g" "${dockerfile}"

    (cd "${BUILD_DIR}" && "${CONTAINER_ENGINE}" build "${BUILD_OPTS[@]}" . -t "${FULL_IMAGE_TAG}" --build-arg DB_VERSION="${CONTAINER_DB_VERSION}")
    "${CONTAINER_ENGINE}" run -d --name "${CONTAINER_DB_NAME}" -p "${CONTAINER_DB_PORT}:${DEFAULT_PORT}" "${VOLUME_ARG[@]}" "${FULL_IMAGE_TAG}"
    ;;

  mssql|"sql server")
    DEFAULT_PORT=1433
    CONTAINER_DB_PORT="${CONTAINER_DB_PORT:-$DEFAULT_PORT}"
    get_volume_param "/var/opt/mssql"
    log_info "Building & launching Microsoft SQL Server..."
    cp -rf "${PROJECT_ROOT}/Database/SqlServer/." "${BUILD_DIR}/"

    dockerfile="${BUILD_DIR}/Dockerfile"
    sed -i "s/MSSQL_SA_PASSWORD_VALUE/$(get_property 'MSSQL_SA_PASSWORD')/g" "${dockerfile}"
    sed -i "s/MSSQL_DB_VALUE/$(get_property 'MSSQL_DBNAME')/g" "${dockerfile}"
    sed -i "s/MSSQL_USER_VALUE/$(get_property 'MSSQL_USER_ID')/g" "${dockerfile}"
    sed -i "s/MSSQL_PASSWORD_VALUE/$(get_property 'MSSQL_USER_PASSWORD')/g" "${dockerfile}"
    sed -i "s/MSSQL_SCHEMA_VALUE/$(get_property 'MSSQL_USER_SCHEMA')/g" "${dockerfile}"

    if [[ "${CONTAINER_DB_VERSION}" == "latest" ]]; then
      CONTAINER_DB_VERSION="2022-latest"
    fi

    (cd "${BUILD_DIR}" && "${CONTAINER_ENGINE}" build "${BUILD_OPTS[@]}" . -t "${FULL_IMAGE_TAG}" --build-arg DB_VERSION="${CONTAINER_DB_VERSION}")
    "${CONTAINER_ENGINE}" run -d --name "${CONTAINER_DB_NAME}" -p "${CONTAINER_DB_PORT}:${DEFAULT_PORT}" "${VOLUME_ARG[@]}" "${FULL_IMAGE_TAG}"
    ;;

  oracle)
    DEFAULT_PORT=1521
    CONTAINER_DB_PORT="${CONTAINER_DB_PORT:-$DEFAULT_PORT}"
    get_volume_param "/opt/oracle/oradata"
    log_info "Building & launching Oracle Autonomous Database Free..."
    cp -rf "${PROJECT_ROOT}/Database/Oracle/." "${BUILD_DIR}/"

    dockerfile="${BUILD_DIR}/Dockerfile"
    sed -i "s/WALLET_PASSWORD_VALUE/$(get_property 'ORACLE_WALLET_PASSWORD')/g" "${dockerfile}"
    sed -i "s/ADMIN_PASSWORD_VALUE/$(get_property 'ORACLE_ADMIN_PASSWORD')/g" "${dockerfile}"
    sed -i "s/DATABASE_NAME_VALUE/$(get_property 'ORACLE_DBNAME')/g" "${dockerfile}"
    sed -i "s/USER_NAME_VALUE/$(get_property 'ORACLE_USER_ID')/g" "${dockerfile}"
    sed -i "s/USER_PASSWORD_VALUE/$(get_property 'ORACLE_USER_PASSWORD')/g" "${dockerfile}"

    (cd "${BUILD_DIR}" && "${CONTAINER_ENGINE}" build "${BUILD_OPTS[@]}" . -t "${FULL_IMAGE_TAG}" --build-arg DB_VERSION="${CONTAINER_DB_VERSION}")
    "${CONTAINER_ENGINE}" run -d --name "${CONTAINER_DB_NAME}" -p "${CONTAINER_DB_PORT}:${DEFAULT_PORT}" --cap-add SYS_ADMIN --device /dev/fuse "${VOLUME_ARG[@]}" "${FULL_IMAGE_TAG}"
    ;;

  mongodb)
    DEFAULT_PORT=27017
    CONTAINER_DB_PORT="${CONTAINER_DB_PORT:-$DEFAULT_PORT}"
    get_volume_param "/data/db"
    log_info "Building & launching MongoDB..."
    cp -rf "${PROJECT_ROOT}/Database/MongoDB/." "${BUILD_DIR}/"

    dockerfile="${BUILD_DIR}/Dockerfile"
    sed -i "s/MONGO_INITDB_DATABASE_VALUE/$(get_property 'MONGODB_DBNAME')/g" "${dockerfile}"
    sed -i "s/MONGO_INITDB_ROOT_USERNAME_VALUE/$(get_property 'MONGODB_USER_ID')/g" "${dockerfile}"
    sed -i "s/MONGO_INITDB_ROOT_PASSWORD_VALUE/$(get_property 'MONGODB_USER_PASSWORD')/g" "${dockerfile}"
    sed -i "s/MONGO_INITDB_SCHEMA_VALUE/$(get_property 'MONGODB_USER_SCHEMA')/g" "${dockerfile}"

    (cd "${BUILD_DIR}" && "${CONTAINER_ENGINE}" build "${BUILD_OPTS[@]}" . -t "${FULL_IMAGE_TAG}" --build-arg DB_VERSION="${CONTAINER_DB_VERSION}")
    "${CONTAINER_ENGINE}" run -d --name "${CONTAINER_DB_NAME}" -p "${CONTAINER_DB_PORT}:${DEFAULT_PORT}" "${VOLUME_ARG[@]}" "${FULL_IMAGE_TAG}"
    ;;

  db2)
    DEFAULT_PORT=50000
    CONTAINER_DB_PORT="${CONTAINER_DB_PORT:-$DEFAULT_PORT}"
    get_volume_param "/database"
    log_info "Building & launching IBM DB2..."
    cp -rf "${PROJECT_ROOT}/Database/IBMDB2/." "${BUILD_DIR}/"

    dockerfile="${BUILD_DIR}/Dockerfile"
    sed -i "s/DB2_DB2INSTANCE_VALUE/$(get_property 'DB2_DB2INSTANCE')/g" "${dockerfile}"
    sed -i "s/DB2_DB2INST1_PASSWORD_VALUE/$(get_property 'DB2_DB2INST1_PASSWORD')/g" "${dockerfile}"
    sed -i "s/DB2_DBNAME_VALUE/$(get_property 'DB2_DBNAME')/g" "${dockerfile}"
    sed -i "s/DB2_USERID_VALUE/$(get_property 'DB2_USER_ID')/g" "${dockerfile}"
    sed -i "s/DB2_USERPASS_VALUE/$(get_property 'DB2_USER_PASS')/g" "${dockerfile}"
    sed -i "s/DB2_USERSCHEMA_VALUE/$(get_property 'DB2_USER_SCHEMA')/g" "${dockerfile}"

    (cd "${BUILD_DIR}" && "${CONTAINER_ENGINE}" build "${BUILD_OPTS[@]}" . -t "${FULL_IMAGE_TAG}" --build-arg DB_VERSION="${CONTAINER_DB_VERSION}")
    "${CONTAINER_ENGINE}" run -d --name "${CONTAINER_DB_NAME}" -p "${CONTAINER_DB_PORT}:${DEFAULT_PORT}" "${VOLUME_ARG[@]}" "${FULL_IMAGE_TAG}"
    ;;

  cockroach|cockroachdb)
    DEFAULT_PORT=26257
    CONTAINER_DB_PORT="${CONTAINER_DB_PORT:-$DEFAULT_PORT}"
    get_volume_param "/cockroach/cockroach-data"
    log_info "Building & launching CockroachDB..."
    cp -rf "${PROJECT_ROOT}/Database/CockroachDB/." "${BUILD_DIR}/"

    dockerfile="${BUILD_DIR}/Dockerfile"
    sed -i "s/COCKROACH_DATABASE_VALUE/$(get_property 'COCKROACH_DBNAME')/g" "${dockerfile}"
    sed -i "s/COCKROACH_USER_VALUE/$(get_property 'COCKROACH_USER_ID')/g" "${dockerfile}"
    sed -i "s/COCKROACH_PASSWORD_VALUE/$(get_property 'COCKROACH_USER_PASSWORD')/g" "${dockerfile}"

    (cd "${BUILD_DIR}" && "${CONTAINER_ENGINE}" build "${BUILD_OPTS[@]}" . -t "${FULL_IMAGE_TAG}" --build-arg DB_VERSION="${CONTAINER_DB_VERSION}")
    "${CONTAINER_ENGINE}" run -d --name "${CONTAINER_DB_NAME}" -p "${CONTAINER_DB_PORT}:${DEFAULT_PORT}" -p 8080:8080 "${VOLUME_ARG[@]}" "${FULL_IMAGE_TAG}"
    ;;

  snowflake|snowflake-emulator)
    DEFAULT_PORT=8080
    CONTAINER_DB_PORT="${CONTAINER_DB_PORT:-$DEFAULT_PORT}"
    get_volume_param "/data"
    log_info "Building & launching Snowflake Local Emulator..."
    cp -rf "${PROJECT_ROOT}/Database/Snowflake/." "${BUILD_DIR}/"

    dockerfile="${BUILD_DIR}/Dockerfile"
    sed -i "s/SNOWFLAKE_DATABASE_VALUE/$(get_property 'SNOWFLAKE_DBNAME')/g" "${dockerfile}"
    sed -i "s/SNOWFLAKE_SCHEMA_VALUE/$(get_property 'SNOWFLAKE_SCHEMA')/g" "${dockerfile}"
    sed -i "s/SNOWFLAKE_USER_VALUE/$(get_property 'SNOWFLAKE_USER_ID')/g" "${dockerfile}"
    sed -i "s/SNOWFLAKE_PASSWORD_VALUE/$(get_property 'SNOWFLAKE_USER_PASSWORD')/g" "${dockerfile}"

    (cd "${BUILD_DIR}" && "${CONTAINER_ENGINE}" build "${BUILD_OPTS[@]}" . -t "${FULL_IMAGE_TAG}" --build-arg DB_VERSION="${CONTAINER_DB_VERSION}")
    "${CONTAINER_ENGINE}" run -d --name "${CONTAINER_DB_NAME}" -p "${CONTAINER_DB_PORT}:${DEFAULT_PORT}" "${VOLUME_ARG[@]}" "${FULL_IMAGE_TAG}"
    ;;

  databricks|spark-delta|delta-lake)
    DEFAULT_PORT=10000
    CONTAINER_DB_PORT="${CONTAINER_DB_PORT:-$DEFAULT_PORT}"
    get_volume_param "/opt/spark/data"
    log_info "Building & launching Databricks Local Engine (Apache Spark + Delta Lake)..."
    cp -rf "${PROJECT_ROOT}/Database/Databricks/." "${BUILD_DIR}/"

    (cd "${BUILD_DIR}" && "${CONTAINER_ENGINE}" build "${BUILD_OPTS[@]}" . -t "${FULL_IMAGE_TAG}" --build-arg DB_VERSION="${CONTAINER_DB_VERSION}")
    "${CONTAINER_ENGINE}" run -d --name "${CONTAINER_DB_NAME}" -p "${CONTAINER_DB_PORT}:${DEFAULT_PORT}" -p 4040:4040 "${VOLUME_ARG[@]}" "${FULL_IMAGE_TAG}"
    ;;

  *)
    log_error "Unknown database type: ${CONTAINER_DB_TYPE}"
    show_usage
    exit 1
    ;;
esac

# Monitor container readiness
wait_for_container_health "${CONTAINER_DB_NAME}" "${CONTAINER_DB_PORT}"
